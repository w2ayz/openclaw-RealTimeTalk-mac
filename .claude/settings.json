{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse_git_commit.py\"",
            "if": "Bash(git commit*)",
            "timeout": 30,
            "statusMessage": "Running pre-commit quality check (ruff)…"
          }
        ]
      }
    ]
  }
}
