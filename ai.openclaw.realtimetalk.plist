<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.realtimetalk</string>

    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>__DAEMON_PATH__</string>
        <string>--http-port</string>
        <string>19000</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
        <key>DYLD_LIBRARY_PATH</key>
        <string>/opt/homebrew/lib:/usr/local/lib</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/openclaw/realtimetalk.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/openclaw/realtimetalk.log</string>

    <key>WorkingDirectory</key>
    <string>__SKILL_DIR__</string>
</dict>
</plist>
